@model RotaCerta.Models.Reserva

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes</h1>

<div>
    <h4>Reserva de @Model.Nome</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Quantidade de Pessoas: 
        </dt>
        <dd class = "col-sm-10">
            @Model.QuantidadeDePessoas
        </dd>
        <dt class = "col-sm-2">
            Valor Total: 
        </dt>
        <dd class = "col-sm-10">
            @Model.ValorTotal
        </dd>
    </dl>
</div>
<div class="mt-4">
    <a asp-action="Lista" class="btn btn-primary text-decoration-none text-white ms-2">Voltar</a>
</div>