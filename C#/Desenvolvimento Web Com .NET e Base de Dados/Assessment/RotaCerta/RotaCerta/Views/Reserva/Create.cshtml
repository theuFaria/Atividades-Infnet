@model RotaCerta.Models.Reserva

@{
    ViewData["Title"] = "Fazer Reserva";
}


<h1 class="text-primary text-center">Faça sua Reserva</h1>


<section class="row bg-body-secondary rounded-3 mt-5 p-4 w-50 m-auto">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (TempData["MensagemDeErro"] != null)
        {
            <div class="alert-danger alert">
                @TempData["MensagemDeErro"]
            </div>
        }
        <div class="form-group mb-2">
            <label asp-for="PacoteTuristicoId" class="control-label mb-1">Pacote Turístico:</label>
            <select asp-for="PacoteTuristicoId" class="form-control form-select" asp-items="ViewBag.PacoteTuristicoId">
                <option value="" selected="">Escolha o pacote turístico</option>
            </select>
        </div>
        <div class="form-group mb-3">
            <label asp-for="QuantidadeDePessoas" class="control-label mb-1">Quantidade de Pessoas: </label>
            <input asp-for="QuantidadeDePessoas" type="number" class="form-control"/>
            <span asp-validation-for="QuantidadeDePessoas" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Nome" class="control-label mb-1">Nome Completo para Reserva:</label>
            <input asp-for="Nome" class="form-control"/>
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>
        <div class="w-100 text-center">
            <input type="submit" value="Reservar" class="btn-success btn shadow form-control w-25"/>
        </div>
        <div class="w-100 text-center">
            <a asp-action="Index" asp-controller="PacoteTuristico" class="btn btn-primary shadow form-control mt-3 w-25">Voltar</a>
        </div>
    </form>
</section>


@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
