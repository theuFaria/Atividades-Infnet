@model RotaCerta.Models.Reserva

@{
    ViewData["Title"] = "Deletar";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<h3 class="text-center text-danger">Tem certeza que deseja deletar a reserva?</h3>
<div class="w-100 d-flex justify-content-center">
<form asp-action="DeletarReserva" method="post" class="mt-4">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Deletar" class="btn btn-danger" />
    <a asp-action="Lista" class="text-decoration-none btn btn-success text-white ms-4">Voltar</a>
</form>
</div>