@model RotaCerta.Models.PacoteTuristico

@{
    ViewData["Title"] = "Editar";
}

<h1>Editar Pacote</h1>

<h4>Pacote Turístico</h4>
<hr/>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (TempData["MensagemDeErro"] != null)
            {
                <div class="alert-danger alert">
                    @TempData["MensagemDeErro"]
                </div>
            }
            <input type="hidden" asp-for="Id"/>
            <div class="form-group">
                <label asp-for="Titulo" class="control-label">Nome:</label>
                <input asp-for="Titulo" class="form-control"/>
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DestinoId" class="control-label">Destino: </label>
                <select asp-for="DestinoId" class="form-control form-select" asp-items="ViewBag.DestinoId">
                    <option value="@Model.DestinoId" selected=""></option>
                </select>
                <span asp-validation-for="Destino" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataIda" class="control-label">Data de Ida:</label>
                <input asp-for="DataIda" class="form-control"/>
                <span asp-validation-for="DataIda" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataRetorno" class="control-label">Data de Retorno:</label>
                <input asp-for="DataRetorno" class="form-control"/>
                <span asp-validation-for="DataRetorno" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CapacidadeMaxima" class="control-label">Capacidade máxima:</label>
                <input asp-for="CapacidadeMaxima" class="form-control"/>
                <span asp-validation-for="CapacidadeMaxima" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrecoPorPessoa" class="control-label">Valor por Pessoa:</label>
                <input asp-for="PrecoPorPessoa" class="form-control"/>
                <span asp-validation-for="PrecoPorPessoa" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Salvar" class="btn btn-success"/>
                <a asp-action="Index" class="btn btn-primary text-decoration-none text-white">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
