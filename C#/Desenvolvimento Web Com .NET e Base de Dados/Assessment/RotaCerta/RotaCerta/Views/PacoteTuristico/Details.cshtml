@model RotaCerta.Models.PacoteTuristico

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes</h1>

<div>
    <h4>Pacote Turístico</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
           Título: 
        </dt>
        <dd class = "col-sm-10">
            @Model.Titulo
        </dd>
        <dd class="col-sm-2 fw-bold">
            Destino
        </dd>
        <dd class="col-sm-10">
            @Model.Destino.Nome
        </dd>
        <dt class = "col-sm-2">
            Data da Ida: 
        </dt>
        <dd class = "col-sm-10">
            @Model.DataIda
        </dd>
        <dd class="col-sm-2 fw-bold">
            Data de Retorno:
        </dd>
        <dd class="col-sm-10">
            @Model.DataRetorno
        </dd>
        <dt class = "col-sm-2">
            Capacidade máxima:
        </dt>
        <dd class = "col-sm-10">
            @Model.CapacidadeMaxima
        </dd>
        <dt class = "col-sm-2">
            Vagas disponíveis:
        </dt>
        <dd class = "col-sm-10">
            @Model.CapacidadeDisponivel
        </dd>
        <dt class = "col-sm-2">
            Valor:
        </dt>
        <dd class = "col-sm-10">
           R$ @Model.PrecoPorPessoa 
        </dd>
    </dl>
</div>
<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-success text-white text-decoration-none">Editar</a>
    <a asp-action="Index" class="btn btn-primary text-decoration-none text-white ms-2">Voltar</a>
</div>
