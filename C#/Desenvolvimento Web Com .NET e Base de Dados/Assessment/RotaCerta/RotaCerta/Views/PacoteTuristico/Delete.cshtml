@model RotaCerta.Models.PacoteTuristico

@{
    ViewData["Title"] = "Deletar";
}

<h1>@ViewData["Title"]</h1>

<h3>Tem certeza que deseja deletar o pacote?</h3>
<div>
    <h4>Pacote Turístico</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>
        <dt class = "col-sm-2">
            Destino:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Destino.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataIda)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataIda)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CapacidadeMaxima)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CapacidadeMaxima)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PrecoPorPessoa)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PrecoPorPessoa)
        </dd>
    </dl>
    
    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Deletar" class="btn btn-danger" />
        <a asp-action="Index" class="text-decoration-none btn btn-success text-white">Voltar</a>
    </form>
</div>
